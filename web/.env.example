# Copie para .env e preencha. O .env nunca vai para o Git.

# Banco SQLite. Local: arquivo na pasta prisma. No Docker: volume em /data (ver docker-compose.yml).
DATABASE_URL="file:./dev.db"

# Login (Auth.js). Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Endereço público do painel (no servidor). Local: deixe vazio.
AUTH_URL=

# Primeiro usuário, criado por `npm run admin` (só se ainda não existir nenhum).
ADMIN_EMAIL=
ADMIN_NOME=
ADMIN_PASSWORD=

# Segredo que o coletor do PC usa para falar com a API (o mesmo vai no coletor/servidor.json).
COLETOR_TOKEN=

# Notificação no celular (Web Push). Gere com: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Porta do app no servidor (docker-compose). Escolha uma livre.
APP_PORT=3200
