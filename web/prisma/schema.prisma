// PromoTrix — banco SQLite próprio (arquivo num volume Docker), isolado dos bancos dos outros
// projetos do servidor. Listas de termos (precisa/qualquer/naoPode) ficam como JSON em texto.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  nome         String
  passwordHash String
  criadoEm     DateTime           @default(now())
  pushes       PushSubscription[]
}

/// Termo pesquisado no Pelando pelo coletor do PC.
model Busca {
  id    String  @id @default(cuid())
  termo String
  ate   String? /// AAAA-MM-DD: depois disso a busca para sozinha
  ativa Boolean @default(true)
  ordem Int     @default(0)
}

/// Regra que decide o que avisa. A primeira que bater vence (ordem).
model Regra {
  id             String     @id @default(cuid())
  grupo          String
  nome           String
  prioridade     String     @default("normal") /// "alta" (janela grande + push) ou "normal" (painel)
  precisa        String     @default("[]")
  qualquer       String     @default("[]")
  naoPode        String     @default("[]")
  precoMin       Float?
  precoMax       Float?
  temperaturaMin Float?
  /// Preço normal do produto, tirado de loja de verdade. Serve para calcular o % de desconto.
  precoReferencia Float?
  /// Só avisa se o desconto for pelo menos este %.
  descontoMin    Float?
  /// Passagem aérea: JSON com origens, destinos, datas, max_paradas e intervalo_h. Preenchido, a
  /// regra não olha o Pelando — o coletor lê o preço do trecho no Google Flights (coletor/voos.py).
  voo            String?
  ate            String?
  ativa          Boolean    @default(true)
  ordem          Int        @default(0)
  promocoes      Promocao[]
}

/// Cada envio do coletor do PC.
model Coleta {
  id     String   @id @default(cuid())
  em     DateTime @default(now())
  lidas  Int
  dentro Int
  novos  Int
}

/// Promoção do Pelando que bateu numa regra (o id é o do Pelando).
model Promocao {
  id             String    @id
  titulo         String
  preco          Float?
  loja           String
  temperatura    Float     @default(0)
  postadaEm      DateTime?
  link           String
  cupom          String?
  /// Foto do produto (servida pelo Pelando).
  imagem         String?
  /// % de desconto e de onde ele veio (cupom do Pelando, "X% OFF" no título ou o preço normal da regra).
  desconto       Float?
  descontoOrigem String?
  regraId        String?
  regra          Regra?    @relation(fields: [regraId], references: [id], onDelete: SetNull)
  primeiraVez    DateTime  @default(now())
  ultimaVez      DateTime  @default(now())
  ultimaColetaId String?
  avisadaEm      DateTime?
  precos         Preco[]

  @@index([regraId])
  @@index([ultimaColetaId])
}

/// Um preço lido numa coleta. Só grava quando muda de valor, senão a série de uma passagem lida de
/// 4 em 4 horas viraria uma fila de pontos iguais. É o que o painel desenha no gráfico.
model Preco {
  id         String   @id @default(cuid())
  promocaoId String
  promocao   Promocao @relation(fields: [promocaoId], references: [id], onDelete: Cascade)
  valor      Float
  em         DateTime @default(now())

  @@index([promocaoId, em])
}

/// Cupom de loja do Pelando: um post sem produto ("R$ 300 OFF em R$ 1999"). O coletor manda todos os
/// ativos; os que servem em algum item monitorado vêm com a lista em `servem`. O id é o do Pelando.
model Cupom {
  id             String    @id
  titulo         String
  loja           String
  link           String
  codigo         String?
  /// O desconto é um % (com ou sem limite em reais) ou um valor fixo em reais.
  porcentagem    Float?
  valorFixo      Float?
  /// Compra mínima e limite do desconto, lidos do título ("acima de R$ 1999", "limitado à R$ 500").
  minimo         Float?
  limite         Float?
  /// "R$ 300 OFF" / "30% OFF" e "acima de R$ 1.999 · até R$ 500", prontos do coletor.
  valorTxt       String
  regrasTxt      String    @default("")
  /// JSON: condições do título ([Prime], [Porto Bank], cashback...).
  condicoes      String    @default("[]")
  /// JSON: [{regra_id, regra_nome, prioridade, valor, base, base_tipo}] — itens em que pode servir.
  servem         String    @default("[]")
  temperatura    Float     @default(0)
  postadoEm      DateTime?
  primeiraVez    DateTime  @default(now())
  ultimaVez      DateTime  @default(now())
  ultimaColetaId String?
  avisadoEm      DateTime?

  @@index([ultimaColetaId])
}

model PushSubscription {
  id       String   @id @default(cuid())
  userId   String
  endpoint String   @unique
  p256dh   String
  auth     String
  criadoEm DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
